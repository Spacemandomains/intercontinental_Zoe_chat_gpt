# --- Required ---

# YouTube Data API v3 key (see docs/youtube-api-key.md)
YOUTUBE_API_KEY=

# Resend API key for lead email delivery (https://resend.com)
RESEND_API_KEY=

# Email address that receives lead notifications
LEAD_EMAIL_TO=zoe@example.com

# Verified sender address (must be verified in Resend)
LEAD_EMAIL_FROM=no-reply@example.com

# --- Optional ---

# stdio (default) for local Claude Code / Claude Desktop, http for remote MCP + ChatGPT
MCP_TRANSPORT=stdio

# HTTP transport port (only used when MCP_TRANSPORT=http)
PORT=3000

# Bearer token required for /mcp and /actions/* when HTTP transport is enabled
HTTP_AUTH_TOKEN=

# Canonical data directory (JSON files for destinations, services, products, etc.)
DATA_DIR=./data

# Cache TTLs (milliseconds)
CACHE_TTL_PLAYLIST_MS=3600000
CACHE_TTL_VIDEO_MS=86400000
CACHE_TTL_TRANSCRIPT_MS=86400000

# Fallback transcript language
DEFAULT_TRANSCRIPT_LANG=en

# Logging
LOG_LEVEL=info
NODE_ENV=development
