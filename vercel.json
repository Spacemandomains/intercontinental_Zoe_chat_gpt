{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'intercontinental-zoe is an API-only project; Vercel compiles api/[...path].ts directly'",
  "outputDirectory": "public",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/healthz", "destination": "/api/healthz" },
    { "source": "/openapi.json", "destination": "/api/openapi.json" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/mcp/:path*", "destination": "/api/mcp/:path*" },
    { "source": "/actions/:tool", "destination": "/api/actions/:tool" },
    { "source": "/actions/:tool/:path*", "destination": "/api/actions/:tool/:path*" }
  ]
}
